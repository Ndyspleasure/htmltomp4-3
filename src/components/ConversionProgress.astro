<section data-el="progress-section" class="card hidden" aria-labelledby="step-progress">
  <h2 id="step-progress" class="step-title">
    <span class="step-badge" aria-hidden="true">
      5
    </span>{' '}
    Memproses
  </h2>
  <p data-el="progress-stage" class="mt-3 text-sm font-medium" aria-live="polite"></p>
  <div class="mt-3 h-3 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
    <div
      data-el="progress-bar"
      class="h-full w-0 rounded-full bg-brand-600 transition-[width]"
      role="progressbar"
      aria-label="Progres konversi"
      aria-valuemin="0"
      aria-valuemax="100"
    ></div>
  </div>
  <p class="hint mt-2">Proses berjalan di perangkat Anda (Web Worker). Jangan tutup tab ini.</p>
  <button type="button" data-el="cancel-processing" class="btn-secondary mt-3">
    Batalkan konversi
  </button>
</section>
