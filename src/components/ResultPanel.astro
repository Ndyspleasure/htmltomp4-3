<section data-el="result-section" class="card hidden" aria-labelledby="step-result">
  <h2 id="step-result" class="step-title">
    <span class="step-badge" aria-hidden="true">
      6
    </span>{' '}
    Hasil
  </h2>
  <div data-el="result-player" class="mt-4 flex justify-center rounded-xl bg-black/90 p-2"></div>
  <dl data-el="result-meta" class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm"></dl>
  <ul
    data-el="result-notes"
    class="mt-3 hidden list-disc space-y-1 pl-6 text-sm text-amber-700 dark:text-amber-400"
  ></ul>
  <p data-el="result-playback" class="hint mt-2" aria-live="polite"></p>
  <div class="mt-4 flex flex-wrap gap-2">
    <a data-el="download" class="btn-primary" href="#" download>
      Unduh
    </a>
    <button type="button" data-el="reexport" class="btn-secondary">
      Ekspor ulang dengan pengaturan saat ini
    </button>
    <button type="button" data-el="record-again" class="btn-secondary">
      Rekam ulang
    </button>
  </div>
</section>
